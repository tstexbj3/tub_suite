{
 "absolute_value": 0,
 "add_comment_info": 0,
 "add_copies": "",
 "align_labels_right": 0,
 "creation": "2026-01-12 15:50:03.414025",
 "custom_format": 1,
 "disabled": 0,
 "doc_type": "Asset Repair",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "hide_if_not_default": 0,
 "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<style>\r\n@page {\r\n    size: A4;\r\n    margin: 8mm 10mm;\r\n}\r\n* { margin: 0; padding: 0; box-sizing: border-box; }\r\nbody {\r\n    font-family: 'Sarabun', 'TH Sarabun New', Arial, sans-serif;\r\n    font-size: 11px;\r\n    line-height: 1.3;\r\n}\r\n\r\n/* 4-COLUMN HEADER */\r\n.header-grid {\r\n    display: grid;\r\n    grid-template-columns: 120px 1fr auto 80px;\r\n    gap: 10px;\r\n    border-bottom: 1px solid #333;\r\n    padding: 3px 0 5px 0;\r\n    margin-bottom: 5px;\r\n    align-items: center;\r\n}\r\n.header-logo img {\r\n    max-width: 120px;\r\n    max-height: 120px;\r\n    display: block;\r\n}\r\n.header-company {\r\n    font-size: 8px;\r\n    line-height: 1.2;\r\n}\r\n.header-company strong {\r\n    font-size: 9px;\r\n}\r\n.header-title {\r\n    text-align: right;\r\n    font-weight: bold;\r\n    font-size: 13px;\r\n}\r\n.header-qr img {\r\n    max-width: 70px;\r\n    max-height: 70px;\r\n}\r\n\r\n.info-line {\r\n    margin: 1px 0;\r\n    font-size: 10px;\r\n    line-height: 1.4;\r\n}\r\n.info-line-large {\r\n    margin: 1px 0;\r\n    font-size: 12px;\r\n    line-height: 1.4;\r\n}\r\n.field-label {\r\n    font-weight: bold;\r\n}\r\n\r\n/* TWO COLUMNS LAYOUT */\r\n.two-col {\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 15px;\r\n    margin: 1px 0;\r\n}\r\n.two-col-left {\r\n    padding-right: 10px;\r\n}\r\n.two-col-right {\r\n    padding-left: 10px;\r\n}\r\n\r\n/* SIGNATURE BOXES - REDUCED SPACING */\r\n.sig-container {\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 10px;\r\n    margin: 0;\r\n}\r\n.sig-small {\r\n    text-align: center;\r\n    font-size: 9px;\r\n    padding: 2px;\r\n    line-height: 1.2;\r\n}\r\n.sig-small .field-label {\r\n    margin-bottom: 2px;\r\n}\r\n.sig-small img {\r\n    max-width: 80px;\r\n    max-height: 30px;\r\n    margin: 2px auto;\r\n    display: block;\r\n}\r\n.sig-line-small {\r\n    border-top: 1px solid #000;\r\n    margin-top: 3px;\r\n    padding-top: 2px;\r\n    font-size: 8px;\r\n}\r\n\r\n/* THREE SIGNATURE BOXES */\r\n.sig-row {\r\n    display: flex;\r\n    gap: 10px;\r\n    margin: 2px 0 0 0;\r\n}\r\n.sig-box {\r\n    flex: 1;\r\n    text-align: center;\r\n    font-size: 9px;\r\n    line-height: 1;\r\n.sig-box div {\r\n    margin: 0;\r\n    padding: 0;\r\n    line-height: 1;\r\n}\r\n.sig-box > div:first-child {\r\n    font-weight: bold;\r\n}\r\n}\r\n.sig-box img {\r\n    max-width: 100px;\r\n    max-height: 50px;\r\n    margin: 0 auto;\r\n    display: block;\r\n}\r\n.sig-line {\r\n    border-top: 1px solid #000;\r\n    margin-top: -2px;\r\n    padding-top: 0;\r\n}\r\n\r\ntable {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin: 1px 0;\r\n    font-size: 8px;\r\n}\r\ntable th, table td {\r\n    border: 1px solid #000;\r\n    padding: 1px 2px;\r\n}\r\ntable th {\r\n    font-weight: bold;\r\n    background: #f5f5f5;\r\n}\r\n\r\n.section-title {\r\n    font-weight: bold;\r\n    font-size: 12px;\r\n    margin: 5px 0 3px 0;\r\n    padding: 3px;\r\n    background: #f0f0f0;\r\n    border-left: 4px solid #333;\r\n}\r\n.footer-text {\r\n    text-align: center;\r\n    font-size: 9px;\r\n    margin-top: 10px;\r\n}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<!-- 4-COLUMN HEADER: LETTERHEAD | COMPANY | TITLE | QR -->\r\n<div class=\"header-grid\">\r\n    <div class=\"header-logo\">\r\n        <img src=\"/files/banner.png\" alt=\"Logo\">\r\n    </div>\r\n    <div class=\"header-company\">\r\n        <strong>TIPUBON</strong><br>\r\n        \u0e1a\u0e23\u0e34\u0e29\u0e31\u0e17 \u0e17\u0e34\u0e1e\u0e22\u0e4c\u0e1e\u0e25\u0e1a\u0e23\u0e23\u0e08\u0e38\u0e20\u0e31\u0e13\u0e11\u0e4c \u0e08\u0e33\u0e01\u0e31\u0e14<br>\r\n        5/5 \u0e2b\u0e21\u0e39\u0e48 2 \u0e15.\u0e17\u0e23\u0e07\u0e04\u0e19\u0e2d\u0e07 \u0e2d.\u0e2a\u0e32\u0e21\u0e1e\u0e23\u0e32\u0e19 \u0e08.\u0e19\u0e04\u0e23\u0e1b\u0e10\u0e21 73210<br>\r\n        \u0e42\u0e17\u0e23:085-199-9823 \u0e41\u0e1f\u0e01\u0e0b\u0e4c:034-393-825\r\n    </div>\r\n    <div class=\"header-title\">\r\n        \u0e43\u0e1a\u0e41\u0e08\u0e49\u0e07\u0e0b\u0e48\u0e2d\u0e21/\u0e15\u0e34\u0e14\u0e15\u0e31\u0e49\u0e07\u0e43\u0e2b\u0e21\u0e48<br>\r\n        FM-EN-04<br>\r\n        <span style=\"font-size:10px;\">{{ doc.name }}</span>\r\n    </div>\r\n    <div class=\"header-qr\">\r\n        <img src=\"{{ qr_src(doc.doctype, doc.name) }}\" alt=\"QR\">\r\n    </div>\r\n</div>\r\n\r\n<!-- TWO COLUMNS: \u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e41\u0e08\u0e49\u0e07\u0e40\u0e2a\u0e35\u0e22 | \u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e01\u0e32\u0e23\u0e0b\u0e48\u0e2d\u0e21 -->\r\n<div class=\"two-col\">\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e41\u0e08\u0e49\u0e07\u0e40\u0e2a\u0e35\u0e22:</span> {{ frappe.utils.formatdate(doc.failure_date, \"dd/MM/yyyy\") if doc.failure_date else \"\" }}\r\n    </div>\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">\u0e1b\u0e23\u0e30\u0e40\u0e20\u0e17\u0e01\u0e32\u0e23\u0e0b\u0e48\u0e2d\u0e21 (Repair Type):</span> {{ doc.repair_type or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<!-- TWO COLUMNS: \u0e1c\u0e39\u0e49\u0e41\u0e08\u0e49\u0e07 | \u0e2b\u0e19\u0e48\u0e27\u0e22\u0e07\u0e32\u0e19 -->\r\n<div class=\"two-col\">\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">\u0e1c\u0e39\u0e49\u0e41\u0e08\u0e49\u0e07:</span> {{ frappe.get_fullname(doc.reported_by) if doc.reported_by else frappe.get_fullname(doc.owner) }}\r\n    </div>\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">\u0e2b\u0e19\u0e48\u0e27\u0e22\u0e07\u0e32\u0e19:</span> {{ doc.reporter_department or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<!-- TWO COLUMNS: \u0e23\u0e2b\u0e31\u0e2a\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e08\u0e31\u0e01\u0e23 | \u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e08\u0e31\u0e01\u0e23 -->\r\n{% set asset_item_code = frappe.db.get_value('Asset', doc.asset, 'item_code') if doc.asset else None %}\r\n<div class=\"two-col\">\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">\u0e23\u0e2b\u0e31\u0e2a\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e08\u0e31\u0e01\u0e23/\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c:</span> {{ asset_item_code or doc.asset or \"-\" }}\r\n    </div>\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e04\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e08\u0e31\u0e01\u0e23/\u0e2d\u0e38\u0e1b\u0e01\u0e23\u0e13\u0e4c:</span> {{ doc.asset_name or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<div class=\"info-line\" style=\"margin-bottom: 5px;\">\r\n    <span class=\"field-label\">\u0e40\u0e23\u0e37\u0e48\u0e2d\u0e07\u0e17\u0e35\u0e48\u0e41\u0e08\u0e49\u0e07 (Subject):</span> {{ doc.repair_subject or \"-\" }}\r\n</div>\r\n\r\n<!-- TWO COLUMNS: \u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14 LEFT | SIGNATURES RIGHT -->\r\n<div class=\"two-col\" style=\"align-items: center;\">\r\n    <div class=\"two-col-left\">\r\n        <div class=\"field-label\">\u0e23\u0e32\u0e22\u0e25\u0e30\u0e40\u0e2d\u0e35\u0e22\u0e14/\u0e2a\u0e34\u0e48\u0e07\u0e17\u0e35\u0e48\u0e15\u0e49\u0e2d\u0e07\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e01\u0e32\u0e23:</div>\r\n        <div style=\"margin-top:3px; font-size:10px; min-height:80px;\">\r\n            {{ (doc.description or \"\")|replace(\"\\n\",\"<br>\")|safe }}\r\n        </div>\r\n    </div>\r\n    <div class=\"two-col-right\">\r\n        <!-- TWO SIGNATURES SIDE BY SIDE - REDUCED SPACING -->\r\n        <div class=\"sig-container\">\r\n            <div class=\"sig-small\">\r\n                <div class=\"field-label\">\u0e15\u0e49\u0e19\u0e2a\u0e31\u0e07\u0e01\u0e31\u0e14\u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34</div>\r\n                {% if doc.supervisor_section1_signature %}\r\n                <img src=\"{{ doc.supervisor_section1_signature }}\">\r\n                {% elif doc.reporter_signature %}\r\n                <img src=\"{{ doc.reporter_signature }}\">\r\n                {% endif %}\r\n                <div class=\"sig-line-small\"><div style=\"font-size:9px;margin:0;padding:0;\">\u0e2b\u0e31\u0e27\u0e2b\u0e19\u0e49\u0e32\u0e2b\u0e19\u0e48\u0e27\u0e19\u0e41\u0e1c\u0e19\u0e01</div>\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48: {{ frappe.utils.formatdate(doc.supervisor_section1_date or doc.failure_date, \"dd/MM/yyyy\") if (doc.supervisor_section1_date or doc.failure_date) else \"___/___/___\" }}</div>\r\n            </div>\r\n            <div class=\"sig-small\">\r\n                <div class=\"field-label\">\u0e1c\u0e39\u0e49\u0e2d\u0e19\u0e38\u0e21\u0e31\u0e15\u0e34</div>\r\n                {% if doc.custom_gm_signature %}\r\n                <img src=\"{{ doc.custom_gm_signature }}\">\r\n                {% elif doc.gm_section1_signature %}\r\n                <img src=\"{{ doc.gm_section1_signature }}\">\r\n                {% elif doc.approval_signature %}\r\n                <img src=\"{{ doc.approval_signature }}\">\r\n                {% endif %}\r\n                <div class=\"sig-line-small\"><div style=\"font-size:9px;margin:0;padding:0;\">\u0e1c\u0e0a.\u0e1c\u0e39\u0e49\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23/\u0e1c\u0e39\u0e49\u0e08\u0e31\u0e14\u0e01\u0e32\u0e23</div>\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48: {{ frappe.utils.formatdate(doc.gm_section1_approval_date or doc.gm_final_approval_date, \"dd/MM/yyyy\") if (doc.gm_section1_approval_date or doc.gm_final_approval_date) else \"___/___/___\" }}</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<div class=\"section-title\">\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e1d\u0e48\u0e32\u0e22\u0e27\u0e34\u0e28\u0e27\u0e01\u0e23\u0e23\u0e21</div>\r\n\r\n<!-- TWO COLUMNS: \u0e01\u0e32\u0e23\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e01\u0e32\u0e23 | \u0e04\u0e48\u0e32\u0e43\u0e0a\u0e49\u0e08\u0e48\u0e32\u0e22 -->\r\n<div class=\"two-col\">\r\n    <div class=\"two-col-left\">\r\n        <span class=\"field-label\">\u0e01\u0e32\u0e23\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e01\u0e32\u0e23:</span> {{ doc.action_type or \"-\" }}\r\n    </div>\r\n    <div class=\"two-col-right\">\r\n        <span class=\"field-label\">\u0e04\u0e48\u0e32\u0e43\u0e0a\u0e49\u0e08\u0e48\u0e32\u0e22:</span> {{ doc.custom_cost_type or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<table style=\"margin-bottom:0;\">\r\n    <thead>\r\n        <tr>\r\n            <th width=\"8%\">\u0e25\u0e33\u0e14\u0e31\u0e1a</th>\r\n            <th width=\"32%\">\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23/\u0e25\u0e31\u0e01\u0e29\u0e13\u0e30\u0e02\u0e2d\u0e07\u0e07\u0e32\u0e19</th>\r\n            <th width=\"32%\">\u0e01\u0e32\u0e23\u0e41\u0e01\u0e49\u0e44\u0e02/\u0e01\u0e32\u0e23\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e07\u0e32\u0e19</th>\r\n            <th width=\"28%\">\u0e1c\u0e39\u0e49\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e07\u0e32\u0e19</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% if doc.custom_engineering_todo_items and doc.custom_engineering_todo_items|length > 0 %}\r\n            {% for row in doc.custom_engineering_todo_items %}\r\n            <tr>\r\n                <td style=\"text-align:center;\">{{ loop.index }}</td>\r\n                <td>{{ row.task_description or row.todo_item or \"\" }}</td>\r\n                <td>{{ row.action_taken or row.procedure or \"\" }}</td>\r\n                <td>{{ row.assigned_to or row.responsible_person or \"\" }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        {% else %}\r\n            <tr><td style=\"text-align:center;\">1</td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">2</td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">3</td><td></td><td></td><td></td></tr>\r\n        {% endif %}\r\n    </tbody>\r\n</table>\r\n\r\n<div class=\"field-label\" style=\"margin-top:4px;\">\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23/\u0e2d\u0e30\u0e44\u0e2b\u0e25\u0e48\u0e17\u0e35\u0e48\u0e43\u0e0a\u0e49:</div>\r\n<table style=\"margin-bottom:0;\">\r\n    <thead>\r\n        <tr>\r\n            <th width=\"8%\">\u0e25\u0e33\u0e14\u0e31\u0e1a</th>\r\n            <th width=\"40%\">\u0e23\u0e32\u0e22\u0e01\u0e32\u0e23</th>\r\n            <th width=\"22%\">\u0e43\u0e1a\u0e02\u0e2d\u0e0b\u0e37\u0e49\u0e2d\u0e40\u0e25\u0e02\u0e17\u0e35\u0e48</th>\r\n            <th width=\"15%\">\u0e08\u0e33\u0e19\u0e27\u0e19</th>\r\n            <th width=\"15%\">\u0e2b\u0e21\u0e32\u0e22\u0e40\u0e2b\u0e15\u0e38</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% if doc.spare_parts_used and doc.spare_parts_used|length > 0 %}\r\n            {% for row in doc.spare_parts_used %}\r\n            <tr>\r\n                <td style=\"text-align:center;\">{{ loop.index }}</td>\r\n                <td>{{ row.spare_part_name or row.item_name or row.item_code or \"\" }}</td>\r\n                <td>{{ row.purchase_order or \"\" }}</td>\r\n                <td>{{ row.quantity or row.qty or \"\" }} {{ row.uom or \"\" }}</td>\r\n                <td>{{ row.remarks or \"\" }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        {% else %}\r\n            <tr><td style=\"text-align:center;\">1</td><td></td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">2</td><td></td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">3</td><td></td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">4</td><td></td><td></td><td></td><td></td></tr>\r\n        {% endif %}\r\n    </tbody>\r\n</table>\r\n\r\n<div class=\"info-line-large\" style=\"margin-top:2px;\">\r\n    <span class=\"field-label\">\u0e23\u0e30\u0e22\u0e30\u0e40\u0e27\u0e25\u0e32\u0e14\u0e33\u0e40\u0e19\u0e34\u0e19\u0e01\u0e32\u0e23:</span> {{ doc.expected_duration_days or \"-\" }} \u0e27\u0e31\u0e19\r\n    <span class=\"field-label\">\u0e27\u0e31\u0e19\u0e17\u0e35\u0e48\u0e40\