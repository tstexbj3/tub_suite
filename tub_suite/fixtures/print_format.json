[
 {
  "absolute_value": 0,
  "add_comment_info": 0,
  "add_copies": "",
  "align_labels_right": 0,
  "css": null,
  "custom_format": 1,
  "default_condition": null,
  "default_print_language": null,
  "disabled": 0,
  "doc_type": "Asset Repair",
  "docstatus": 0,
  "doctype": "Print Format",
  "font": null,
  "font_size": 14,
  "format_data": null,
  "hide_if_not_default": 0,
  "html": "<!DOCTYPE html>\r\n<html>\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<style>\r\n@page {\r\n    size: A4;\r\n    margin: 8mm 10mm;\r\n}\r\n* { margin: 0; padding: 0; box-sizing: border-box; }\r\nbody {\r\n    font-family: 'Sarabun', 'TH Sarabun New', Arial, sans-serif;\r\n    font-size: 11px;\r\n    line-height: 1.3;\r\n}\r\n\r\n/* 4-COLUMN HEADER */\r\n.header-grid {\r\n    display: grid;\r\n    grid-template-columns: 120px 1fr auto 80px;\r\n    gap: 10px;\r\n    border-bottom: 1px solid #333;\r\n    padding: 3px 0 5px 0;\r\n    margin-bottom: 5px;\r\n    align-items: center;\r\n}\r\n.header-logo img {\r\n    max-width: 120px;\r\n    max-height: 120px;\r\n    display: block;\r\n}\r\n.header-company {\r\n    font-size: 8px;\r\n    line-height: 1.2;\r\n}\r\n.header-company strong {\r\n    font-size: 9px;\r\n}\r\n.header-title {\r\n    text-align: right;\r\n    font-weight: bold;\r\n    font-size: 13px;\r\n}\r\n.header-qr img {\r\n    max-width: 70px;\r\n    max-height: 70px;\r\n}\r\n\r\n.info-line {\r\n    margin: 1px 0;\r\n    font-size: 10px;\r\n    line-height: 1.4;\r\n}\r\n.info-line-large {\r\n    margin: 1px 0;\r\n    font-size: 12px;\r\n    line-height: 1.4;\r\n}\r\n.field-label {\r\n    font-weight: bold;\r\n}\r\n\r\n/* TWO COLUMNS LAYOUT */\r\n.two-col {\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 15px;\r\n    margin: 1px 0;\r\n}\r\n.two-col-left {\r\n    padding-right: 10px;\r\n}\r\n.two-col-right {\r\n    padding-left: 10px;\r\n}\r\n\r\n/* SIGNATURE BOXES - REDUCED SPACING */\r\n.sig-container {\r\n    display: grid;\r\n    grid-template-columns: 1fr 1fr;\r\n    gap: 10px;\r\n    margin: 0;\r\n}\r\n.sig-small {\r\n    text-align: center;\r\n    font-size: 9px;\r\n    padding: 2px;\r\n    line-height: 1.2;\r\n}\r\n.sig-small .field-label {\r\n    margin-bottom: 2px;\r\n}\r\n.sig-small img {\r\n    max-width: 80px;\r\n    max-height: 30px;\r\n    margin: 2px auto;\r\n    display: block;\r\n}\r\n.sig-line-small {\r\n    border-top: 1px solid #000;\r\n    margin-top: 3px;\r\n    padding-top: 2px;\r\n    font-size: 8px;\r\n}\r\n\r\n/* THREE SIGNATURE BOXES */\r\n.sig-row {\r\n    display: flex;\r\n    gap: 10px;\r\n    margin: 2px 0 0 0;\r\n}\r\n.sig-box {\r\n    flex: 1;\r\n    text-align: center;\r\n    font-size: 9px;\r\n    line-height: 1;\r\n.sig-box div {\r\n    margin: 0;\r\n    padding: 0;\r\n    line-height: 1;\r\n}\r\n.sig-box > div:first-child {\r\n    font-weight: bold;\r\n}\r\n}\r\n.sig-box img {\r\n    max-width: 100px;\r\n    max-height: 50px;\r\n    margin: 0 auto;\r\n    display: block;\r\n}\r\n.sig-line {\r\n    border-top: 1px solid #000;\r\n    margin-top: -2px;\r\n    padding-top: 0;\r\n}\r\n\r\ntable {\r\n    width: 100%;\r\n    border-collapse: collapse;\r\n    margin: 1px 0;\r\n    font-size: 8px;\r\n}\r\ntable th, table td {\r\n    border: 1px solid #000;\r\n    padding: 1px 2px;\r\n}\r\ntable th {\r\n    font-weight: bold;\r\n    background: #f5f5f5;\r\n}\r\n\r\n.section-title {\r\n    font-weight: bold;\r\n    font-size: 12px;\r\n    margin: 5px 0 3px 0;\r\n    padding: 3px;\r\n    background: #f0f0f0;\r\n    border-left: 4px solid #333;\r\n}\r\n.footer-text {\r\n    text-align: center;\r\n    font-size: 9px;\r\n    margin-top: 10px;\r\n}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<!-- 4-COLUMN HEADER: LETTERHEAD | COMPANY | TITLE | QR -->\r\n<div class=\"header-grid\">\r\n    <div class=\"header-logo\">\r\n        <img src=\"/files/Screenshot 2025-08-18 224240.png\" alt=\"Logo\">\r\n    </div>\r\n    <div class=\"header-company\">\r\n        <strong>TIPUBON</strong><br>\r\n        บริษัท ทิพย์พลบรรจุภัณฑ์ จำกัด<br>\r\n        5/5 หมู่ 2 ต.ทรงคนอง อ.สามพราน จ.นครปฐม 73210<br>\r\n        โทร:085-199-9823 แฟกซ์:034-393-825\r\n    </div>\r\n    <div class=\"header-title\">\r\n        ใบแจ้งซ่อม/ติดตั้งใหม่<br>\r\n        FM-EN-04<br>\r\n        <span style=\"font-size:10px;\">{{ doc.name }}</span>\r\n    </div>\r\n    <div class=\"header-qr\">\r\n        <img src=\"{{ qr_src(doc.doctype, doc.name) }}\" alt=\"QR\">\r\n    </div>\r\n</div>\r\n\r\n<!-- TWO COLUMNS: วันที่แจ้งเสีย | ประเภทการซ่อม -->\r\n<div class=\"two-col\">\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">วันที่แจ้งเสีย:</span> {{ frappe.utils.formatdate(doc.failure_date, \"dd/MM/yyyy\") if doc.failure_date else \"\" }}\r\n    </div>\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">ประเภทการซ่อม (Repair Type):</span> {{ doc.repair_type or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<!-- TWO COLUMNS: ผู้แจ้ง | หน่วยงาน -->\r\n<div class=\"two-col\">\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">ผู้แจ้ง:</span> {{ frappe.get_fullname(doc.reported_by) if doc.reported_by else frappe.get_fullname(doc.owner) }}\r\n    </div>\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">หน่วยงาน:</span> {{ doc.reporter_department or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<!-- TWO COLUMNS: รหัสเครื่องจักร | ชื่อเครื่องจักร -->\r\n{% set asset_item_code = frappe.db.get_value('Asset', doc.asset, 'item_code') if doc.asset else None %}\r\n<div class=\"two-col\">\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">รหัสเครื่องจักร/อุปกรณ์:</span> {{ asset_item_code or doc.asset or \"-\" }}\r\n    </div>\r\n    <div class=\"info-line\">\r\n        <span class=\"field-label\">ชื่อเครื่องจักร/อุปกรณ์:</span> {{ doc.asset_name or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<div class=\"info-line\" style=\"margin-bottom: 5px;\">\r\n    <span class=\"field-label\">เรื่องที่แจ้ง (Subject):</span> {{ doc.repair_subject or \"-\" }}\r\n</div>\r\n\r\n<!-- TWO COLUMNS: รายละเอียด LEFT | SIGNATURES RIGHT -->\r\n<div class=\"two-col\" style=\"align-items: center;\">\r\n    <div class=\"two-col-left\">\r\n        <div class=\"field-label\">รายละเอียด/สิ่งที่ต้องดำเนินการ:</div>\r\n        <div style=\"margin-top:3px; font-size:10px; min-height:80px;\">\r\n            {{ (doc.description or \"\")|replace(\"\\n\",\"<br>\")|safe }}\r\n        </div>\r\n    </div>\r\n    <div class=\"two-col-right\">\r\n        <!-- TWO SIGNATURES SIDE BY SIDE - REDUCED SPACING -->\r\n        <div class=\"sig-container\">\r\n            <div class=\"sig-small\">\r\n                <div class=\"field-label\">ต้นสังกัดอนุมัติ</div>\r\n                {% if doc.supervisor_section1_signature %}\r\n                <img src=\"{{ doc.supervisor_section1_signature }}\">\r\n                {% elif doc.reporter_signature %}\r\n                <img src=\"{{ doc.reporter_signature }}\">\r\n                {% endif %}\r\n                <div class=\"sig-line-small\"><div style=\"font-size:9px;margin:0;padding:0;\">หัวหน้าหน่วนแผนก</div>วันที่: {{ frappe.utils.formatdate(doc.supervisor_section1_date or doc.failure_date, \"dd/MM/yyyy\") if (doc.supervisor_section1_date or doc.failure_date) else \"___/___/___\" }}</div>\r\n            </div>\r\n            <div class=\"sig-small\">\r\n                <div class=\"field-label\">ผู้อนุมัติ</div>\r\n                {% if doc.custom_gm_signature %}\r\n                <img src=\"{{ doc.custom_gm_signature }}\">\r\n                {% elif doc.gm_section1_signature %}\r\n                <img src=\"{{ doc.gm_section1_signature }}\">\r\n                {% elif doc.approval_signature %}\r\n                <img src=\"{{ doc.approval_signature }}\">\r\n                {% endif %}\r\n                <div class=\"sig-line-small\"><div style=\"font-size:9px;margin:0;padding:0;\">ผช.ผู้จัดการ/ผู้จัดการ</div>วันที่: {{ frappe.utils.formatdate(doc.gm_section1_approval_date or doc.gm_final_approval_date, \"dd/MM/yyyy\") if (doc.gm_section1_approval_date or doc.gm_final_approval_date) else \"___/___/___\" }}</div>\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<div class=\"section-title\">สำหรับฝ่ายวิศวกรรม</div>\r\n\r\n<!-- TWO COLUMNS: การดำเนินการ | ค่าใช้จ่าย -->\r\n<div class=\"two-col\">\r\n    <div class=\"two-col-left\">\r\n        <span class=\"field-label\">การดำเนินการ:</span> {{ doc.action_type or \"-\" }}\r\n    </div>\r\n    <div class=\"two-col-right\">\r\n        <span class=\"field-label\">ค่าใช้จ่าย:</span> {{ doc.custom_cost_type or \"-\" }}\r\n    </div>\r\n</div>\r\n\r\n<table style=\"margin-bottom:0;\">\r\n    <thead>\r\n        <tr>\r\n            <th width=\"8%\">ลำดับ</th>\r\n            <th width=\"32%\">รายการ/ลักษณะของงาน</th>\r\n            <th width=\"32%\">การแก้ไข/การดำเนินงาน</th>\r\n            <th width=\"28%\">ผู้ดำเนินงาน</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% if doc.custom_engineering_todo_items and doc.custom_engineering_todo_items|length > 0 %}\r\n            {% for row in doc.custom_engineering_todo_items %}\r\n            <tr>\r\n                <td style=\"text-align:center;\">{{ loop.index }}</td>\r\n                <td>{{ row.task_description or row.todo_item or \"\" }}</td>\r\n                <td>{{ row.action_taken or row.procedure or \"\" }}</td>\r\n                <td>{{ row.assigned_to or row.responsible_person or \"\" }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        {% else %}\r\n            <tr><td style=\"text-align:center;\">1</td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">2</td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">3</td><td></td><td></td><td></td></tr>\r\n        {% endif %}\r\n    </tbody>\r\n</table>\r\n\r\n<div class=\"field-label\" style=\"margin-top:4px;\">รายการ/อะไหล่ที่ใช้:</div>\r\n<table style=\"margin-bottom:0;\">\r\n    <thead>\r\n        <tr>\r\n            <th width=\"8%\">ลำดับ</th>\r\n            <th width=\"40%\">รายการ</th>\r\n            <th width=\"22%\">ใบขอซื้อเลขที่</th>\r\n            <th width=\"15%\">จำนวน</th>\r\n            <th width=\"15%\">หมายเหตุ</th>\r\n        </tr>\r\n    </thead>\r\n    <tbody>\r\n        {% if doc.spare_parts_used and doc.spare_parts_used|length > 0 %}\r\n            {% for row in doc.spare_parts_used %}\r\n            <tr>\r\n                <td style=\"text-align:center;\">{{ loop.index }}</td>\r\n                <td>{{ row.spare_part_name or row.item_name or row.item_code or \"\" }}</td>\r\n                <td>{{ row.purchase_order or \"\" }}</td>\r\n                <td>{{ row.quantity or row.qty or \"\" }} {{ row.uom or \"\" }}</td>\r\n                <td>{{ row.remarks or \"\" }}</td>\r\n            </tr>\r\n            {% endfor %}\r\n        {% else %}\r\n            <tr><td style=\"text-align:center;\">1</td><td></td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">2</td><td></td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">3</td><td></td><td></td><td></td><td></td></tr>\r\n            <tr><td style=\"text-align:center;\">4</td><td></td><td></td><td></td><td></td></tr>\r\n        {% endif %}\r\n    </tbody>\r\n</table>\r\n\r\n<div class=\"info-line-large\" style=\"margin-top:2px;\">\r\n    <span class=\"field-label\">ระยะเวลาดำเนินการ:</span> {{ doc.expected_duration_days or \"-\" }} วัน\r\n    <span class=\"field-label\">วันที่เริ่มต้น:</span> {{ frappe.utils.formatdate(doc.repair_start_date, \"dd/MM/yyyy\") if doc.repair_start_date else \"\" }}\r\n    <span class=\"field-label\">วันที่สิ้นสุด:</span> {{ frappe.utils.formatdate(doc.repair_end_date, \"dd/MM/yyyy\") if doc.repair_end_date else \"\" }}\r\n</div>\r\n\r\n<!-- THREE SIGNATURE BOXES -->\r\n<div class=\"sig-row\">\r\n    <div class=\"sig-box\">\r\n        <div style=\"font-weight:bold;\">ผู้ประเมิน</div>\r\n        {% if doc.engineering_operator_signature %}\r\n        <img src=\"{{ doc.engineering_operator_signature }}\">\r\n        {% endif %}\r\n        <div class=\"sig-line-small\">วันที่: {{ frappe.utils.formatdate(doc.engineering_operator_sign_date, \"dd/MM/yyyy\") if doc.engineering_operator_sign_date else \"___/___/___\" }}</div>\r\n    </div>\r\n    <div class=\"sig-box\">\r\n        <div style=\"font-weight:bold;\">ผู้ควบคุมตรวจสอบ</div>\r\n        {% if doc.eng_supervisor_signature %}\r\n        <img src=\"{{ doc.eng_supervisor_signature }}\">\r\n        {% endif %}\r\n        <div class=\"sig-line-small\"><div style=\"font-size:9px;margin:0;padding:0;\">ผู้จัดการแผนกวิศวกรรม</div>วันที่: {{ frappe.utils.formatdate(doc.eng_supervisor_review_date, \"dd/MM/yyyy\") if doc.eng_supervisor_review_date else \"___/___/___\" }}</div>\r\n    </div>\r\n    <div class=\"sig-box\">\r\n        <div style=\"font-weight:bold;\">ผู้อนุมัติ</div>\r\n        {% if doc.approval_signature %}\r\n        <img src=\"{{ doc.approval_signature }}\">\r\n        {% endif %}\r\n        <div class=\"sig-line-small\"><div style=\"font-size:9px;margin:0;padding:0;\">ผู้จัดการโรงงาน</div>วันที่: {{ frappe.utils.formatdate(doc.gm_final_approval_date, \"dd/MM/yyyy\") if doc.gm_final_approval_date else \"___/___/___\" }}</div>\r\n    </div>\r\n</div>\r\n\r\n<div class=\"info-line-large\">\r\n    <span class=\"field-label\">วันที่ส่งมอบงาน:</span> {{ frappe.utils.formatdate(doc.completion_handover_date, \"dd/MM/yyyy\") if doc.completion_handover_date else \"\" }}\r\n    &nbsp;&nbsp;&nbsp;\r\n    <span class=\"field-label\">ผลการดำเนินการ:</span> {{ doc.repair_result_status or \"-\" }}\r\n</div>\r\n\r\n<div class=\"section-title\">บันทึกสุขลักษณะ/ความปลอดภัย</div>\r\n\r\n<div class=\"info-line\">\r\n    <span class=\"field-label\">สถานะ:</span> {{ doc.hygiene_status or \"เรียบร้อย/สะอาดไม่เสี่ยงต่อการปนเปื้อน (Clean)\" }}\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n    <span class=\"field-label\">ความสะอาดเครื่องก่อน:</span> {{ doc.cleanliness_before_machine or \"สะอาด (Clean)\" }}\r\n    &nbsp;&nbsp;&nbsp;\r\n    <span class=\"field-label\">ความสะอาดเครื่องหลัง:</span> {{ doc.cleanliness_after_machine or \"สะอาด (Clean)\" }}\r\n</div>\r\n\r\n<div class=\"info-line\">\r\n    <span class=\"field-label\">ความสะอาดสถานที่ก่อน:</span> {{ doc.cleanliness_before_area or \"สะอาด (Clean)\" }}\r\n    &nbsp;&nbsp;&nbsp;\r\n    <span class=\"field-label\">ความสะอาดสถานที่หลัง:</span> {{ doc.cleanliness_after_area or \"สะอาด (Clean)\" }}\r\n</div>\r\n\r\n<!-- TWO COLUMNS: อุปกรณ์นำเข้า | อุปกรณ์นำออก -->\r\n<div class=\"two-col\" style=\"font-size:10px; margin-top:5px;\">\r\n    <div class=\"two-col-left\">\r\n        <div class=\"field-label\">อุปกรณ์นำเข้า:</div>\r\n        {% if doc.parts_inserted and doc.parts_inserted|length > 0 %}\r\n            {% for row in doc.parts_inserted %}\r\n            {{ loop.index }}. {{ row.item_name or row.item_code or row.part_name or \"_________________________________\" }}<br>\r\n            {% endfor %}\r\n        {% else %}\r\n            1. _________________________________<br>\r\n            2. _________________________________<br>\r\n            3. _________________________________<br>\r\n            4. _________________________________\r\n        {% endif %}\r\n    </div>\r\n    <div class=\"two-col-right\">\r\n        <div class=\"field-label\">อุปกรณ์นำออก:</div>\r\n        {% if doc.parts_removed and doc.parts_removed|length > 0 %}\r\n            {% for row in doc.parts_removed %}\r\n            {{ loop.index }}. {{ row.item_name or row.item_code or row.part_name or \"_________________________________\" }}<br>\r\n            {% endfor %}\r\n        {% else %}\r\n            1. _________________________________<br>\r\n            2. _________________________________<br>\r\n            3. _________________________________<br>\r\n            4. _________________________________\r\n        {% endif %}\r\n    </div>\r\n</div>\r\n\r\n<!-- TWO COLUMNS: หมายเหตุ | ตัวแทนผู้แจ้งตรวจรับงาน -->\r\n<div class=\"two-col\" style=\"margin-top:10px;\">\r\n    <div class=\"two-col-left\">\r\n        <div class=\"info-line\">\r\n            <span class=\"field-label\">หมายเหตุ:</span> {{ doc.reporter_confirmation_notes or doc.supervisor_verification_notes or \"-\" }}\r\n        </div>\r\n    </div>\r\n    <div class=\"two-col-right\">\r\n        <div style=\"text-align:center;\">\r\n            <div class=\"field-label\">ต้นสังกัดที่แจ้งตรวจรับงาน</div>\r\n            {% if doc.supervisor_signature %}\r\n            <img src=\"{{ doc.supervisor_signature }}\" style=\"max-width:100px; max-height:40px; margin:5px auto; display:block;\">\r\n            {% endif %}\r\n            <div style=\"border-top: 1px solid #000; margin-top: 3px; padding-top: 3px; font-size:10px;\"><div style=\"font-size:9px;margin:0;padding:0;\">หัวหน้าแผนก/แผนก</div>\r\n                วันที่: {{ frappe.utils.formatdate(doc.supervisor_verification_date, \"dd/MM/yyyy\") if doc.supervisor_verification_date else \"\" }}\r\n            </div>\r\n        </div>\r\n    </div>\r\n</div>\r\n\r\n<div class=\"footer-text\">FM-EN-04 Rev.01</div>\r\n\r\n</body>\r\n</html>",
