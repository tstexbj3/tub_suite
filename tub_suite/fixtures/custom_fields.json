[
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-reported_by",
    "dt": "Asset Repair",
    "fieldname": "reported_by",
    "fieldtype": "Link",
    "label": "Reported By (Inspector)",
    "options": "User",
    "insert_after": "error_description",
    "read_only": 1,
    "allow_on_submit": 0,
    "in_list_view": 1,
    "in_standard_filter": 1,
    "description": "Inspector who originally reported this issue"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-expected_completion_date",
    "dt": "Asset Repair",
    "fieldname": "expected_completion_date",
    "fieldtype": "Date",
    "label": "Expected Completion Date",
    "insert_after": "failure_date",
    "allow_on_submit": 1,
    "in_list_view": 1,
    "bold": 1,
    "description": "When engineer expects to complete this repair"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-issue_severity",
    "dt": "Asset Repair",
    "fieldname": "issue_severity",
    "fieldtype": "Select",
    "label": "Issue Severity",
    "options": "\nMinor - Asset Operational\nMajor - Asset Must Stop",
    "default": "Minor - Asset Operational",
    "insert_after": "expected_completion_date",
    "allow_on_submit": 1,
    "in_list_view": 1,
    "in_standard_filter": 1,
    "bold": 1,
    "description": "Engineer sets severity: Minor = asset keeps running, Major = asset stops"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-verification_section",
    "dt": "Asset Repair",
    "fieldname": "verification_section",
    "fieldtype": "Section Break",
    "label": "Inspector Verification",
    "insert_after": "completion_date",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-requires_inspector_verification",
    "dt": "Asset Repair",
    "fieldname": "requires_inspector_verification",
    "fieldtype": "Check",
    "label": "Requires Inspector Verification",
    "default": "1",
    "insert_after": "verification_section",
    "allow_on_submit": 1,
    "description": "Inspector must verify repair before manager approval"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-verified_by",
    "dt": "Asset Repair",
    "fieldname": "verified_by",
    "fieldtype": "Link",
    "label": "Verified By (Inspector)",
    "options": "User",
    "insert_after": "requires_inspector_verification",
    "read_only": 1,
    "allow_on_submit": 1,
    "depends_on": "eval:doc.requires_inspector_verification==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-verification_date",
    "dt": "Asset Repair",
    "fieldname": "verification_date",
    "fieldtype": "Datetime",
    "label": "Verification Date & Time",
    "insert_after": "verified_by",
    "read_only": 1,
    "allow_on_submit": 1,
    "depends_on": "eval:doc.requires_inspector_verification==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-verification_notes",
    "dt": "Asset Repair",
    "fieldname": "verification_notes",
    "fieldtype": "Small Text",
    "label": "Verification Notes",
    "insert_after": "verification_date",
    "allow_on_submit": 1,
    "depends_on": "eval:doc.requires_inspector_verification==1",
    "description": "Inspector's notes after verifying the repair"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset Repair-verification_status",
    "dt": "Asset Repair",
    "fieldname": "verification_status",
    "fieldtype": "Select",
    "label": "Verification Status",
    "options": "\nPending Verification\nVerified - Passed\nVerified - Failed\nNot Required",
    "default": "Pending Verification",
    "insert_after": "verification_notes",
    "in_list_view": 1,
    "in_standard_filter": 1,
    "allow_on_submit": 1,
    "depends_on": "eval:doc.requires_inspector_verification==1"
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-qr_code_section",
    "dt": "Asset",
    "fieldname": "qr_code_section",
    "fieldtype": "Section Break",
    "label": "QR Code",
    "insert_after": "image",
    "collapsible": 1
  },
  {
    "doctype": "Custom Field",
    "name": "Asset-qr_code",
    "dt": "Asset",
    "fieldname": "qr_code",
    "fieldtype": "Attach Image",
    "label": "QR Code",
    "insert_after": "qr_code_section",
    "read_only": 1
  }
]
