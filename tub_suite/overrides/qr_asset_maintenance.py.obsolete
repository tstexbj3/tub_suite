"""
QR Code integration for Assets - Redirects to Maintenance Portal
When an Asset QR is scanned, redirect to /maintenance with asset context
"""

import frappe
from frappe import _
from frappe.utils import get_url


@frappe.whitelist()
def generate_asset_qr(asset_name):
    """
    Generate QR code for an Asset that redirects to maintenance page
    Uses Manual mode to encode direct URL
    Login check is handled by maintenance page itself
    """
    # Check permission
    if not frappe.has_permission("Asset", "read", asset_name):
        frappe.throw(_("Not permitted"), frappe.PermissionError)
    
    # Get or create QR List for this asset
    qr_list_name = f"Asset-Maintenance-{asset_name}"
    
    if frappe.db.exists("QR List", qr_list_name):
        # Delete and recreate to ensure correct URL
        frappe.delete_doc("QR List", qr_list_name, force=1)
        frappe.db.commit()
    
    # Get asset details
    asset = frappe.get_doc("Asset", asset_name)
    
    # Build maintenance URL with asset parameter
    maintenance_url = get_url(f"/maintenance?asset={asset_name}")
    
    # Create QR List with Manual mode (direct URL encoding)
    qr_list = frappe.get_doc({
        "doctype": "QR List",
        "name": qr_list_name,
        "qr_mode": "Manual",  # Direct URL encoding
        "manual_content": maintenance_url,
        "label_text": f"{asset.asset_name or asset_name}"
    })
    qr_list.insert(ignore_permissions=True)
    
    # Generate and attach QR image
    from qr_foundry.api import attach_qr_list
    result = attach_qr_list(qr_list.name)
    
    frappe.db.commit()
    
    return {
        "qr_list": qr_list.name,
        "file_url": result.get("file_url"),
        "absolute_file_url": result.get("absolute_file_url"),
        "scan_url": maintenance_url
    }
